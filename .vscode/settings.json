{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "search.exclude": {
    "**/node_modules": true,
    "**/.expo": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/repo-sweep": true
  }
}
